NODE_ENV=production
PUBLIC_BASE_URL=https://ai.jsanconsulting.com
MAX_USERS=20
ALLOWED_EMAIL_DOMAIN=jsanconsulting.com
SESSION_HOURS=12
REGISTRATION_ACCESS_CODE=<generate-strong-secret>
JWT_SECRET=<generate-64-char-secret>
KEY_ENCRYPTION_SECRET=<generate-64-char-secret>
DEVELOPER_MONTHLY_BUDGET_USD=0
DEVELOPER_RPM_LIMIT=30
DEVELOPER_TPM_LIMIT=0
# The portal stores everything in SQLite, so it needs an attached Railway
# volume. Mount one and point this at it - the container filesystem is
# ephemeral, so without a volume every deploy starts from an empty database.
SQLITE_PATH=/data/jsan.db
LITELLM_BASE_URL=http://litellm.railway.internal:${{litellm.PORT}}
LITELLM_MASTER_KEY=${{litellm.LITELLM_MASTER_KEY}}
# Optional. Accounts reconciled into existence at every boot, as a JSON array of
# {name, email, password}. Seeding bypasses REGISTRATION_ACCESS_CODE and
# ALLOWED_EMAIL_DOMAIN — those govern who may claim a seat from outside, while
# this is the operator naming who already holds one — but the accounts do occupy
# seats against MAX_USERS once created. The password set here is authoritative:
# there is no change-password route, so a row whose hash no longer matches it is
# corrected at the next start. Leave unset to require everyone to register.
# SEED_ACCOUNTS=[{"name":"Admin","email":"admin@example.com","password":"<at-least-10-chars>"}]

# Failed sign-in policy. This many wrong passwords locks the address for this
# many minutes, counted in the database so a deploy does not clear it. The
# lockout is keyed on the address typed, so it also applies to addresses with no
# account - otherwise the difference would reveal which addresses are real.
LOGIN_MAX_ATTEMPTS=3
LOGIN_LOCKOUT_MINUTES=30
