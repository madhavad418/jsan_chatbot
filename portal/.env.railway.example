NODE_ENV=production
PUBLIC_BASE_URL=https://ai.jsanconsulting.com
MAX_USERS=20
ALLOWED_EMAIL_DOMAIN=jsanconsulting.com
SESSION_HOURS=12
REGISTRATION_ACCESS_CODE=<generate-strong-secret>
JWT_SECRET=<generate-64-char-secret>
KEY_ENCRYPTION_SECRET=<generate-64-char-secret>
DEVELOPER_MONTHLY_BUDGET_USD=0
DEVELOPER_RPM_LIMIT=30
DEVELOPER_TPM_LIMIT=0
# The portal stores everything in SQLite, so it needs an attached Railway
# volume. Mount one and point this at it - the container filesystem is
# ephemeral, so without a volume every deploy starts from an empty database.
SQLITE_PATH=/data/jsan.db
LITELLM_BASE_URL=http://litellm.railway.internal:${{litellm.PORT}}
LITELLM_MASTER_KEY=${{litellm.LITELLM_MASTER_KEY}}
