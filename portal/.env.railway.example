NODE_ENV=production
PUBLIC_BASE_URL=https://ai.jsanconsulting.com
MAX_USERS=20
ALLOWED_EMAIL_DOMAIN=jsanconsulting.com
SESSION_HOURS=12
REGISTRATION_ACCESS_CODE=<generate-strong-secret>
JWT_SECRET=<generate-64-char-secret>
KEY_ENCRYPTION_SECRET=<generate-64-char-secret>
DEVELOPER_MONTHLY_BUDGET_USD=0
DEVELOPER_RPM_LIMIT=30
DEVELOPER_TPM_LIMIT=0
DATABASE_URL=${{Postgres.DATABASE_URL}}
LITELLM_BASE_URL=http://litellm.railway.internal:${{litellm.PORT}}
LITELLM_MASTER_KEY=${{litellm.LITELLM_MASTER_KEY}}

# Preview mode — only while Postgres does not exist yet.
#
# Drops the sign-in screen and serves one shared anonymous session. Chat works;
# conversations are held in the service's memory and lost on every restart or
# redeploy; personal developer keys and per-developer usage stay unavailable,
# because both are per account.
#
# While it is on, DATABASE_URL, REGISTRATION_ACCESS_CODE, JWT_SECRET and
# KEY_ENCRYPTION_SECRET are unused and may be omitted. LITELLM_MASTER_KEY is
# still required — it is what answers chat.
#
# Anyone who reaches the URL is in, and every request spends from the master
# key's budget. Keep the service without a public domain while this is on, and
# remove the variable before inviting developers.
# AUTH_DISABLED=true
