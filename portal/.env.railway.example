NODE_ENV=production
PUBLIC_BASE_URL=https://ai.jsanconsulting.com
MAX_USERS=20
ALLOWED_EMAIL_DOMAIN=jsanconsulting.com
SESSION_HOURS=12
REGISTRATION_ACCESS_CODE=<generate-strong-secret>
JWT_SECRET=<generate-64-char-secret>
KEY_ENCRYPTION_SECRET=<generate-64-char-secret>
DEVELOPER_MONTHLY_BUDGET_USD=0
DEVELOPER_RPM_LIMIT=30
DEVELOPER_TPM_LIMIT=0
