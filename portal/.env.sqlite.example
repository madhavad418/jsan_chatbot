# Local development with SQLite — a temporary stand-in for Postgres.
#
# Copy to portal/api/.env and fill in the secrets, then run the API from
# portal/api. Sign-in, registration, saved conversations and Slides all work,
# and the data survives a restart because it lives in a file.
#
# This is for one developer on one machine. SQLite is a single local file with no
# managed backups, and the deployed stack still expects Postgres — LiteLLM cannot
# use SQLite at all. See RAILWAY_DEPLOYMENT_GUIDE.md for the production setup.

NODE_ENV=development
PUBLIC_BASE_URL=http://localhost:5173

# Storage: a local file instead of a database server.
DB_DRIVER=sqlite
SQLITE_PATH=./data/jsan-dev-ai.db

# Generate each of these once, locally:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=<generate-64-char-secret>
KEY_ENCRYPTION_SECRET=<generate-64-char-secret>
REGISTRATION_ACCESS_CODE=<pick-anything-for-local-use>

# Seats and sign-up rules. Leave ALLOWED_EMAIL_DOMAIN unset locally so any
# address can register; set it to jsanconsulting.com for a real deployment.
MAX_USERS=20
SESSION_HOURS=12
# ALLOWED_EMAIL_DOMAIN=jsanconsulting.com

# The AI gateway. Required — it is what answers chat and organises slides.
#
# LiteLLM stores its virtual keys in its own Postgres, so a gateway without one
# cannot issue per-developer keys. Registration still succeeds: model calls fall
# back to this key, server-side, and the Tools page says the personal key is
# pending. Point this at a LiteLLM you are running, or at any OpenAI-compatible
# endpoint while developing.
LITELLM_BASE_URL=http://127.0.0.1:4000
LITELLM_MASTER_KEY=<the-gateway-key>
